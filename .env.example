# Copy to .env (gitignored). Used to encrypt sensitive sections before they
# are committed to the public repo. Enter the SAME passphrase once in the
# website on your iPhone to unlock those sections there.
BRIEFING_PASSPHRASE=change-me-to-a-long-random-passphrase

# GitHub repo the pipeline pushes docs/ to. Leave as-is if run_pipeline.py
# is invoked from inside the repo working tree (recommended).
GIT_REMOTE=origin
GIT_BRANCH=main
